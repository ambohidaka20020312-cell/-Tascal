FLASK_ENV=development
SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql://tascal:password@localhost/tascal_dev
JWT_SECRET_KEY=change-me-in-production
ANTHROPIC_API_KEY=sk-ant-...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_TEAM=price_...
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# CORS / フロントエンドURL
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Push notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=tascal.support@gmail.com

# Mail settings (Gmail SMTP)
# Gmail の「アプリパスワード」を使用 (2段階認証を有効にして取得)
# https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tascal.support@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx  # 16桁のアプリパスワード
MAIL_DEFAULT_SENDER=tascal.support@gmail.com

# File storage (S3 / Cloudflare R2)
# Leave S3_ENDPOINT_URL empty to use local filesystem (development fallback)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=tascal-uploads
S3_PUBLIC_URL=
S3_REGION=auto
